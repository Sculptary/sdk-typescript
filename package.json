{
  "name": "@sculptary/sdk",
  "version": "0.4.0",
  "description": "TypeScript SDK for Sculptary: version control and collaboration for 3D",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": "github:Sculptary/sdk-typescript",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "pnpm build && playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "typescript": "~5.9",
    "vitest": "^5.1.0"
  }
}
